#!/bin/sh
set -eu

# Keep the service running during upgrades. postinst will restart it after the
# new unit/binaries have been unpacked, which is the standard
# dh_installsystemd --restart-after-upgrade lifecycle.
if [ -z "${DPKG_ROOT:-}" ] && [ "${1:-}" = remove ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop meow-comment.service >/dev/null || true
fi

exit 0
