{
  "name": "@neko_vecter/meow-comment-ui",
  "version": "1.0.6",
  "description": "A lightweight comment editor for Meow Comment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neko-vecter/meow-comment.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "main": "./dist/MeowCommentUI.js",
  "module": "./dist/MeowCommentUI.mjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/MeowCommentUI.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/MeowCommentUI.cjs"
      }
    },
    "./MeowCommentUI.css": "./dist/MeowCommentUI.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite --open /dev-view/",
    "build": "tsc --noEmit && vite build",
    "prepack": "pnpm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "25.9.5",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "sass": "1.101.3",
    "terser": "5.49.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0"
  }
}
